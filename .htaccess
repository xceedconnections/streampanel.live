RewriteEngine On
RewriteBase /

# IMPORTANT: Handle API endpoints FIRST - rewrite requests without .php back to .php
# This must be before the redirect rule to prevent .php from being stripped
RewriteCond %{REQUEST_URI} ^/tv/api/viewer_tracker(\?.*)?$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^tv/api/viewer_tracker$ tv/api/viewer_tracker.php [L,QSA]

# Allow API endpoints with .php extension to work directly
RewriteCond %{REQUEST_URI} ^/tv/api/.*\.php [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Allow embed-source.php to work directly (needed for HTML embed sources)
# This must be before the .php redirect rule to prevent issues with Firefox/Android
RewriteCond %{REQUEST_URI} ^/embed-source\.php [NC]
RewriteRule ^ - [L]

# Handle sitemap XML requests - rewrite .xml to .php
RewriteCond %{REQUEST_URI} ^/sitemap-tv-channels\.xml$ [NC]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^sitemap-tv-channels\.xml$ sitemap-tv-channels.php [L,QSA]

# Allow sitemap PHP files to work directly
RewriteCond %{REQUEST_URI} ^/sitemap.*\.php [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Allow diagnostic/utility scripts with .php extension to work directly
RewriteCond %{REQUEST_URI} ^/(fix_user_login_check|_db_check|reset_admin_password|force_fix_tv_login|check_tv_login_setting|test_tv_login|fix_tv_login_setting)\.php [NC]
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Redirect old .php URLs to clean URLs (301 permanent redirect)
# But exclude API endpoints, admin panel, diagnostic scripts, and sitemaps - check THE_REQUEST to see original URL
RewriteCond %{THE_REQUEST} \s/([^?\s]*?)\.php[\s?] [NC]
RewriteCond %{THE_REQUEST} !\s/tv/api/viewer_tracker [NC]
RewriteCond %{THE_REQUEST} !\s/admin/ [NC]
RewriteCond %{THE_REQUEST} !\s/api/ [NC]
RewriteCond %{THE_REQUEST} !\s/embed-source\.php [NC]
RewriteCond %{THE_REQUEST} !\s/sitemap [NC]
RewriteCond %{THE_REQUEST} !\s/fix_user_login_check\.php [NC]
RewriteCond %{THE_REQUEST} !\s/_db_check\.php [NC]
RewriteCond %{THE_REQUEST} !\s/reset_admin_password\.php [NC]
RewriteCond %{THE_REQUEST} !\s/force_fix_tv_login\.php [NC]
RewriteCond %{THE_REQUEST} !\s/check_tv_login_setting\.php [NC]
RewriteCond %{THE_REQUEST} !\s/test_tv_login\.php [NC]
RewriteCond %{THE_REQUEST} !\s/fix_tv_login_setting\.php [NC]
RewriteRule ^ %1? [R=301,L]

# Handle root URL (index.php)
RewriteRule ^$ index.php [L]

# Redirect /watch-live-tv/{slug} to tv-channel.php (full player) with slug parameter
RewriteRule ^watch-live-tv/([a-z0-9-]+)/?$ tv/tv-channel.php?slug=$1 [L,QSA]

# Redirect /tv/{slug} to channel info page with slug parameter
RewriteRule ^tv/([a-z0-9-]+)/?$ tv/channel-info.php?slug=$1 [L,QSA]

# Handle clean URLs without .php extension
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(live-tv|movies|tv-shows|profile|login|register|watch|manage-devices|tv-show-detail|report|logout|search)$ $1.php [L,QSA]

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "\.(sql|md|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>
