RewriteEngine On
# UNIVERSAL Apache config — works at domain root OR any subdirectory.
# Auto-synced by config/htaccess.php from detected APP_BASE_PATH.
# No manual RewriteBase / domain edits needed on deploy.
# APP_BASE: /stream
Options -Indexes -MultiViews
DirectoryIndex index.php index.html

# Listing routes that collide with real folders (must be before -d pass-through)
RewriteRule ^movies/?$ movies.php [L,QSA]

# API endpoints without .php
RewriteRule ^tv/api/viewer_tracker/?$ tv/api/viewer_tracker.php [L,QSA]
RewriteRule ^shows/api/viewer_tracker/?$ shows/api/viewer_tracker.php [L,QSA]
RewriteRule ^movies/api/viewer_tracker/?$ movies/api/viewer_tracker.php [L,QSA]
RewriteRule ^api/search-suggest/?$ api/search-suggest.php [L,QSA]

# Sitemap XML -> PHP
RewriteRule ^sitemap-tv-channels\.xml$ sitemap-tv-channels.php [L,QSA]

# Pass through real files and directories
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect old .php URLs to clean URLs (preserves install path from THE_REQUEST)
RewriteCond %{THE_REQUEST} \s/+(.+?)\.php([?\s]) [NC]
RewriteCond %{THE_REQUEST} !/index\.php[?\s] [NC]
RewriteCond %{THE_REQUEST} !/admin/ [NC]
RewriteCond %{THE_REQUEST} !/api/ [NC]
RewriteCond %{THE_REQUEST} !/tv/api/ [NC]
RewriteCond %{THE_REQUEST} !/shows/api/ [NC]
RewriteCond %{THE_REQUEST} !/movies/api/ [NC]
RewriteCond %{THE_REQUEST} !/embed-source\.php [NC]
RewriteCond %{THE_REQUEST} !/embed-movie-source\.php [NC]
RewriteCond %{THE_REQUEST} !/countdown\.php [NC]
RewriteCond %{THE_REQUEST} !/sitemap [NC]
RewriteCond %{THE_REQUEST} !/proxy/ [NC]
RewriteCond %{THE_REQUEST} !/fix_user_login_check\.php [NC]
RewriteCond %{THE_REQUEST} !/_db_check\.php [NC]
RewriteCond %{THE_REQUEST} !/reset_admin_password\.php [NC]
RewriteCond %{THE_REQUEST} !/force_fix_tv_login\.php [NC]
RewriteCond %{THE_REQUEST} !/check_tv_login_setting\.php [NC]
RewriteCond %{THE_REQUEST} !/test_tv_login\.php [NC]
RewriteCond %{THE_REQUEST} !/fix_tv_login_setting\.php [NC]
RewriteCond %{THE_REQUEST} !/debug_login_settings\.php [NC]
RewriteCond %{THE_REQUEST} !/fix_login_settings\.php [NC]
RewriteCond %{THE_REQUEST} !/test_tv_shows_login\.php [NC]
RewriteCond %{THE_REQUEST} !/test_login_debug\.php [NC]
RewriteCond %{THE_REQUEST} !/test_viewer_tracking\.php [NC]
RewriteCond %{THE_REQUEST} !/test_tv_show_detail\.php [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Home
RewriteRule ^$ index.php [L]

# Pretty routes
RewriteRule ^watch-live-tv/([a-z0-9-]+)/?$ tv/tv-channel.php?slug=$1 [L,QSA]
RewriteRule ^tv/([a-z0-9-]+)/?$ tv/channel-info.php?slug=$1 [L,QSA]
RewriteRule ^tv-show/([a-z0-9-]+)/?$ tv-show-detail.php?slug=$1 [L,QSA]
RewriteRule ^watch-tv-show/([a-z0-9-]+)/(s[0-9]+e[0-9]+)/?$ watch.php?type=tv_episode&show_slug=$1&episode_info=$2 [L,QSA]
RewriteRule ^countdown/([a-z0-9-]+)/?$ countdown.php?slug=$1 [L,QSA]
RewriteRule ^actors/([a-z0-9-]+)/?$ actor.php?slug=$1 [L,QSA]
RewriteRule ^movies/([a-z0-9-]+)/watch/?$ movies/movie-watch.php?slug=$1 [L,QSA]
RewriteRule ^movies/([a-z0-9-]+)/?$ movie-detail.php?slug=$1 [L,QSA]
RewriteRule ^movie/([a-z0-9-]+)/?$ movies/$1 [R=301,L]
RewriteRule ^watch-movie/([a-z0-9-]+)/?$ movies/$1/watch [R=301,L]

# Clean page URLs without .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(live-tv|movies|movie-detail|tv-shows|profile|login|register|watch|manage-devices|tv-show-detail|report|logout|search|about-us|contact|careers|terms-of-use|privacy-policy|cookie-policy)/?$ $1.php [L,QSA]

<FilesMatch "\.(sql|md|log)$">
    Require all denied
</FilesMatch>
